<div class="catalog-page" data-controller="modal">
  <%= link_to root_path, class: "catalog-back" do %>
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="19" y1="12" x2="5" y2="12"></line>
      <polyline points="12 19 5 12 12 5"></polyline>
    </svg>
    На главную
  <% end %>

  <div class="catalog-header">
    <div class="catalog-cover catalog-cover-page catalog-cover-placeholder">
      <span class="catalog-cover-letter"><%= @catalog.name[0..1].upcase %></span>
    </div>
    <div class="catalog-header-info">
      <h1 class="catalog-title-page"><%= @catalog.name %></h1>
      <% if @catalog.description.present? %>
        <p class="catalog-desc-page"><%= @catalog.description %></p>
      <% end %>
    </div>
  </div>

  <div class="catalog-elements-section">
    <div class="catalog-elements-header">
      <h2>Элементы каталога</h2>
      <button type="button" class="btn btn-primary" data-action="modal#open">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <line x1="5" y1="12" x2="19" y2="12"></line>
        </svg>
        Создать элемент
      </button>
    </div>

    <% if @catalog.elements.any? %>
      <div class="elements-grid">
        <% @catalog.elements.order(created_at: :desc).each do |element| %>
          <%= render 'elements/element', element: element %>
        <% end %>
      </div>
    <% else %>
      <div class="catalog-empty">
        <div class="catalog-empty-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="12" y1="8" x2="12" y2="16"></line>
            <line x1="8" y1="12" x2="16" y2="12"></line>
          </svg>
        </div>
        <p class="catalog-empty-title">В этом каталоге пока нет элементов</p>
        <p class="catalog-empty-text">Добавьте первый элемент, чтобы начать наполнять каталог</p>
      </div>
    <% end %>
  </div>

  <!-- Модальное окно создания элемента -->
  <div class="modal-overlay" data-modal-target="overlay" data-action="click->modal#closeOnOverlay" style="display: none;">
    <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="element-modal-title" data-modal-target="dialog">
      <div class="modal-header">
        <h2 class="modal-title" id="element-modal-title">Создать элемент</h2>
        <button type="button" class="modal-close" data-action="modal#close" aria-label="Закрыть">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <p class="modal-subtitle">Добавьте новый элемент в каталог</p>

      <%= form_with model: Element.new, url: catalog_elements_path(@catalog), class: "modal-form", data: { action: "turbo:submit-start->modal#submitStart turbo:submit-end->modal#submitEnd" } do |f| %>
        <div class="form-group">
          <%= f.label :title, "Название" %>
          <%= f.text_field :title, placeholder: "Например, Интерстеллар", required: true, maxlength: 100 %>
          <span class="char-counter"><span data-modal-target="charCounter">0</span>/100</span>
        </div>

        <div class="form-group">
          <%= f.label :description, "Описание" %>
          <%= f.text_area :description, placeholder: "Расскажи немного об этом элементе...", rows: 3 %>
        </div>

        <!-- Предпросмотр карточки элемента -->
        <div class="element-preview">
          <div class="element-preview-cover">
            <span class="element-preview-letter" data-modal-target="previewLetter">?</span>
          </div>
          <div class="element-preview-info">
            <span class="element-preview-title" data-modal-target="previewTitle">Название элемента</span>
            <span class="element-preview-desc" data-modal-target="previewDesc">Описание элемента</span>
            <div class="element-preview-rating">
              <span class="element-preview-stars" data-modal-target="previewStars"></span>
              <span class="element-preview-rating-value" data-modal-target="previewRating">0/10</span>
            </div>
          </div>
        </div>

        <!-- Рейтинг звёздами -->
        <div class="form-group">
          <%= f.label :rating, "Рейтинг" %>
          <div class="rating-stars" data-modal-target="ratingStars">
            <% 1.upto(10) do |i| %>
              <button type="button" class="rating-star" data-rating="<%= i %>" data-action="modal#setRating" aria-label="Рейтинг <%= i %>">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                  <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
                </svg>
              </button>
            <% end %>
          </div>
          <span class="rating-value"><span data-modal-target="ratingValue">0</span>/10</span>
          <%= f.hidden_field :rating, value: 0 %>
        </div>

        <div class="modal-actions">
          <button type="button" class="btn btn-outline" data-action="modal#close">Отмена</button>
          <%= f.submit "Создать элемент", class: "btn btn-primary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
