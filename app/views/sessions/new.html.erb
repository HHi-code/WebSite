<div class="auth-page">
  <div class="auth-box">
    <h2 class="auth-title">Вход</h2>

    <%= form_with url: login_path, class: "auth-form" do |f| %>
      <div class="form-group">
        <%= f.label :email, "Email" %>
        <%= f.email_field :email, placeholder: "your@email.com", required: true %>
      </div>

      <div class="form-group">
        <%= f.label :password, "Пароль" %>
        <%= f.password_field :password, placeholder: "Пароль", required: true %>
      </div>

      <%= f.submit "Войти", class: "btn btn-primary btn-full" %>
    <% end %>

    <p class="auth-switch">
      Нет аккаунта? <%= link_to "Зарегистрироваться", signup_path %>
    </p>
  </div>
</div>