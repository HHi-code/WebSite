<%= link_to catalog_element_path(element.catalog, element), class: "element-card" do %>
  <div class="element-cover element-cover-placeholder">
    <span class="element-cover-letter"><%= element.title[0..1].upcase %></span>
  </div>
  <div class="element-info">
    <h3 class="element-title"><%= element.title %></h3>
    <% if element.description.present? %>
      <p class="element-desc"><%= element.description.length > 20 ? "#{element.description[0..19]}..." : element.description %></p>
    <% end %>
    <div class="element-rating">
      <span class="element-stars">
        <% 1.upto(10) do |i| %>
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="<%= i <= (element.rating || 0) ? 'star-filled' : 'star-empty' %>">
            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
          </svg>
        <% end %>
      </span>
      <span class="element-rating-value"><%= element.rating || 0 %>/10</span>
    </div>
  </div>
<% end %>
