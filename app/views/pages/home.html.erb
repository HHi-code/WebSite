<div class="home-container">
  <h1 class="home-title">MediaLibrary</h1>

  <% if logged_in? %>
    <div class="welcome-box">
      <p class="welcome-text">Привет, <strong><%= current_user.email %></strong>!</p>
      <%= button_to "Выйти", logout_path, method: :delete, class: "btn btn-outline" %>
    </div>
  <% else %>
    <div class="auth-box">
      <h2 class="auth-title">Регистрация</h2>
      <%= form_with model: @user || User.new, url: signup_path, class: "auth-form" do |f| %>
        <div class="form-group">
          <%= f.label :email, "Email" %>
          <%= f.email_field :email, placeholder: "your@email.com", required: true, autofocus: true %>
        </div>
        <div class="form-group">
          <%= f.label :password, "Пароль" %>
          <%= f.password_field :password, placeholder: "Минимум 6 символов", required: true, minlength: 6 %>
        </div>
        <%= f.submit "Зарегистрироваться", class: "btn btn-primary btn-full" %>
      <% end %>
      <p class="auth-switch">Уже есть аккаунт? <%= link_to "Войти", login_path %></p>
    </div>
  <% end %>
</div>
