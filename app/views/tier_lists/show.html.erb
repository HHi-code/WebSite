<div class="home-layout" data-controller="tier-list modal" data-tier-list-url-value="<%= tier_list_layout_path(@tier_list) %>">
  <div class="home-main">
    <div class="tier-editor">
      <div class="tier-editor-header">
        <%= link_to tier_lists_path, class: "tier-editor-back" do %>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Мои тирлисты
        <% end %>
        <h1 class="tier-editor-title"><%= @tier_list.title %></h1>
        <div class="tier-save-status" data-tier-list-target="status" aria-live="polite"></div>
        <button type="button" class="tier-save-retry" data-tier-list-target="retry" data-action="click->tier-list#retry" hidden>Повторить</button>
      </div>

      <% if @tier_list.description.present? %>
        <p class="tier-editor-desc"><%= @tier_list.description %></p>
      <% end %>

      <div data-action="pointerdown->tier-list#startDrag dragstart->tier-list#preventNativeDrag">
        <div class="tier-board">
          <% TierList::RANKS.each do |rank| %>
            <div class="tier-row">
              <div class="tier-rank-label" data-rank="<%= rank %>"><%= rank %></div>
              <div class="tier-zone" data-tier-list-target="zone" data-rank="<%= rank %>">
                <% @ranked[rank].each do |element| %>
                  <%= render "tier_lists/card", element: element %>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>

        <div class="tier-unranked">
          <div class="tier-unranked-header">
            <div>
              <h2>Не распределены</h2>
              <span class="tier-unranked-count" id="tier-unranked-count"><%= @unranked.size %></span>
            </div>
            <button type="button" class="btn btn-primary tier-add-element" data-action="modal#open">
              + Создать элемент
            </button>
            <button type="button" class="btn btn-outline tier-import-element" data-action="tier-list#importModalOpen">
              Импорт из каталога
            </button>
          </div>
          <div class="tier-unranked-zone" id="tier-unranked-zone" data-tier-list-target="zone" data-rank="unranked">
            <% if @total_elements.zero? %>
              <div id="tier-empty-state" class="tier-empty" style="display: block;">
                <p class="tier-empty-title">Здесь пока пусто</p>
                <p class="tier-empty-text">Создай первый элемент для этого тирлиста</p>
              </div>
            <% else %>
              <div id="tier-empty-state" class="tier-empty" style="display: none;">
                <p class="tier-empty-title">Здесь пока пусто</p>
                <p class="tier-empty-text">Создай первый элемент для этого тирлиста</p>
              </div>
              <% @unranked.each do |element| %>
                <%= render "tier_lists/card", element: element, show_delete: true %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <%= render "shared/sidebar" %>

  <%= render "tier_lists/element_modal", element: Element.new, open: false %>

  <%= render "tier_lists/import_modal" %>

  <!-- Подтверждение удаления элемента -->
  <div id="tier-delete-confirm" class="modal-overlay" style="display: none;" data-tier-list-target="deleteConfirm" data-action="click->tier-list#cancelDelete">
    <div class="modal-dialog" role="dialog" aria-modal="true" data-action="click->tier-list#stopPropagation">
      <div class="modal-header">
        <h2 class="modal-title" id="tier-delete-confirm-title">Удалить элемент?</h2>
        <button type="button" class="modal-close" data-action="tier-list#cancelDelete" aria-label="Закрыть">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      <p class="modal-subtitle">Удалить этот элемент? Это действие нельзя отменить.</p>
      <div class="modal-actions">
        <button type="button" class="btn btn-outline" data-action="tier-list#cancelDelete">Отмена</button>
        <button type="button" class="btn btn-danger" data-action="tier-list#confirmDelete">Удалить</button>
      </div>
    </div>
  </div>
</div>
