<div class="modal-overlay" id="tier-element-modal" data-modal-target="overlay" data-action="click->modal#closeOnOverlay" style="display: <%= open ? "flex" : "none" %>;">
  <div class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="tier-element-modal-title" data-modal-target="dialog">
    <div class="modal-header">
      <h2 class="modal-title" id="tier-element-modal-title">Создать элемент</h2>
      <button type="button" class="modal-close" data-action="modal#close" aria-label="Закрыть">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
    <p class="modal-subtitle">Новый элемент появится в области «Не распределены» этого тирлиста</p>

    <%= render "tier_lists/element_modal_form", element: element %>

  </div>
</div>
